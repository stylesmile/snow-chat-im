<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.stylesmile.chat.mapper.ChatSessionMapper">
    <resultMap id="chatSession" type="com.stylesmile.chat.entity.ChatSession"/>

    <!-- 清除未读消息数 -->
    <update id="clearUnreadCount">
        UPDATE chat_session SET unread_count = 0 WHERE user_id = #{userId} AND target_id = #{targetId}
    </update>
</mapper>
